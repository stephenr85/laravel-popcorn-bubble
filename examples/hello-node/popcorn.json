{
    "name": "hello-node",
    "runtime": "node@22",
    "entrypoint": "index.js",
    "files": ["index.js"],
    "io": "stdio",
    "description": "The reference Node transform: reads {input, grant} on stdin, returns JSON on stdout.",
    "input": {
        "type": "object",
        "properties": { "name": { "type": "string" } }
